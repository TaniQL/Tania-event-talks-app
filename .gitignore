# pyenv
#   For a library or app, you might want to share your .python-version.
#   Only uncomment if you're using pyenv.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you choose not to, then uncomment the following line:
#Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock is generally recommended to be committed
#poetry.lock

# pdm
#   Similar to Pipenv, pdm.lock is generally recommended to be committed
#pdm.lock
#   pdm build stage
.pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
